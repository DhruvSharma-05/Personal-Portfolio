# Canonical origin. Drives metadataBase, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://dhruvsharma-05.github.io

# EmailJS — https://dashboard.emailjs.com
# These are public by design: EmailJS authenticates the request against the
# domain allowlist configured on the service, not against this key. Still keep
# them here so they can be rotated without touching source.
# The contact form degrades to a "email me directly" message when unset.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
